{
  "name": "fairbite-fresh-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:integration": "pnpm --filter @fairbite/api test:integration",
    "test:e2e": "playwright test",
    "codegen": "graphql-codegen --config codegen.ts && prettier --write packages/identity-contracts/src/generated.ts",
    "test:clients": "vitest run --config vitest.clients.config.ts",
    "codegen:check": "node tools/check-codegen.mjs",
    "check:enatega-ui-source": "node tools/manifest-enatega-ui.mjs --check",
    "check:enatega": "node tools/check-enatega-compatibility.mjs ../upstream contracts docs/ENATEGA_COMPATIBILITY_REPORT.json --check",
    "test:enatega-contracts": "node --test tools/check-enatega-compatibility.test.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.0",
    "prettier": "3.8.1",
    "vitest": "4.1.11",
    "@playwright/test": "1.63.0",
    "testcontainers": "11.7.0",
    "@testcontainers/postgresql": "11.7.0",
    "@graphql-codegen/cli": "7.4.5",
    "@graphql-codegen/typescript": "6.1.1",
    "graphql": "16.11.0",
    "pg": "8.16.3",
    "@types/pg": "8.15.5"
  },
  "type": "module"
}
