{
  "private": true,
  "version": "0.0.0",
  "name": "@fairbite/api",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fairbite/brand": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/apollo": "14.0.3",
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "graphql": "16.11.0",
    "graphql-ws": "6.0.6",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.16.3",
    "ioredis": "5.8.1",
    "bullmq": "6.3.11",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.11",
    "express": "5.2.1",
    "ws": "8.22.0",
    "@fairbite/identity-contracts": "workspace:*",
    "argon2": "0.44.0",
    "jose": "6.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@testcontainers/postgresql": "11.7.0",
    "testcontainers": "11.7.0",
    "@types/pg": "8.15.5",
    "@types/express": "5.0.3",
    "@types/ws": "8.18.2",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "prisma": "7.10.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
