{
  "name": "fairbite-fresh-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:integration": "pnpm --filter @fairbite/api test:integration",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.0",
    "prettier": "3.8.1",
    "vitest": "4.1.11",
    "@playwright/test": "1.63.0",
    "testcontainers": "11.7.0",
    "@testcontainers/postgresql": "11.7.0"
  }
}
