generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
model FoundationMigration {
 id String @id
 appliedAt DateTime @default(now()) @db.Timestamptz(3)
}

model CustomerAddress {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 user IdentityUser @relation(fields:[userId],references:[id],onDelete:Restrict)
 label String @db.VarChar(100)
 deliveryAddress String @db.VarChar(500)
 details String @db.VarChar(1000)
 longitude Float
 latitude Float
 selected Boolean @default(false)
 @@index([userId,id])
}

model CatalogMerchant {
 id String @id @default(uuid()) @db.Uuid
 name String @db.VarChar(100)
 published Boolean @default(false)
 outlets CatalogOutlet[]
}
model CatalogOutlet {
 id String @id @default(uuid()) @db.Uuid
 merchantId String @db.Uuid
 name String @db.VarChar(100)
 currency String @db.VarChar(3)
 published Boolean @default(false)
 merchant CatalogMerchant @relation(fields:[merchantId],references:[id],onDelete:Restrict)
 categories CatalogCategory[]
 items CatalogItem[]
 @@index([merchantId])
 @@index([published,id])
}
model CatalogCategory {
 id String @id @default(uuid()) @db.Uuid
 outletId String @db.Uuid
 name String @db.VarChar(100)
 published Boolean @default(false)
 outlet CatalogOutlet @relation(fields:[outletId],references:[id],onDelete:Restrict)
 items CatalogItem[]
 @@unique([id,outletId])
 @@index([outletId,published,id])
}
model CatalogItem {
 id String @id @default(uuid()) @db.Uuid
 outletId String @db.Uuid
 categoryId String @db.Uuid
 name String @db.VarChar(100)
 description String @default("") @db.VarChar(2000)
 priceMinor Int
 available Boolean @default(true)
 published Boolean @default(false)
 outlet CatalogOutlet @relation(fields:[outletId],references:[id],onDelete:Restrict)
 category CatalogCategory @relation(fields:[categoryId,outletId],references:[id,outletId],onDelete:Restrict)
 @@index([outletId,published,id])
 @@index([categoryId,outletId])
}

model IdentityUser {
 id String @id @default(uuid()) @db.Uuid
 email String @unique @db.VarChar(254)
 displayName String @db.VarChar(100)
 status String @default("ACTIVE")
 emailVerified Boolean @default(false)
 roles String[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 credential IdentityCredential?
 grants IdentityApplicationGrant[]
 families IdentitySessionFamily[]
 addresses CustomerAddress[]
}
model IdentityCredential {
 userId String @id @db.Uuid
 passwordHash String
 user IdentityUser @relation(fields:[userId],references:[id],onDelete:Restrict)
}
model IdentityApplicationGrant {
 userId String @db.Uuid
 application String
 active Boolean @default(true)
 user IdentityUser @relation(fields:[userId],references:[id],onDelete:Restrict)
 @@id([userId,application])
}
model IdentitySessionFamily {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 application String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 expiresAt DateTime @db.Timestamptz(3)
 revokedAt DateTime? @db.Timestamptz(3)
 user IdentityUser @relation(fields:[userId],references:[id],onDelete:Restrict)
 sessions IdentityRefreshSession[]
 @@unique([id,userId])
 @@index([userId])
}
model IdentityRefreshSession {
 id String @id @db.Uuid
 familyId String @db.Uuid
 userId String @db.Uuid
 tokenHash String @unique @db.Char(64)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 consumedAt DateTime? @db.Timestamptz(3)
 family IdentitySessionFamily @relation(fields:[familyId,userId],references:[id,userId],onDelete:Restrict)
 @@index([familyId])
}
model IdentityAuditEvent {
 id String @id @default(uuid()) @db.Uuid
 userId String? @db.Uuid
 familyId String? @db.Uuid
 action String @db.VarChar(40)
 outcome String @db.VarChar(10)
 occurredAt DateTime @default(now()) @db.Timestamptz(3)
}

model RuntimeConfigurationVersion {
 id String @id @default(uuid()) @db.Uuid
 version Int @unique
 document Json @db.JsonB
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 activePointer RuntimeConfigurationPointer?
}
model RuntimeConfigurationPointer {
 id Int @id
 versionId String @unique @db.Uuid
 version RuntimeConfigurationVersion @relation(fields:[versionId],references:[id],onDelete:Restrict)
}
