# Synthetic local examples only; inject actual deployment configuration securely.
APP_ENV=development
PORT=4100
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:4100
GRAPHQL_BODY_LIMIT=1mb
DATABASE_URL=postgresql://placeholder-user:placeholder-password@127.0.0.1:5432/foundation
REDIS_URL=redis://127.0.0.1:6379/0
# Empty denies cross-origin browser access; list exact origins when required.
CORS_ORIGINS=
# Password auth is explicitly opt-in; no default signing/pepper keys exist.
PASSWORD_AUTH_ENABLED=false
# When enabled, inject distinct canonical base64url values encoding 32 random bytes.
# ACCESS_TOKEN_SECRET=
# REFRESH_TOKEN_PEPPER=
# Enatega public-access handshake. Inject a canonical base64url value encoding
# 32 random bytes. The local stack generates and persists a synthetic local key.
PUBLIC_ACCESS_ENFORCED=true
# PUBLIC_ACCESS_SECRET=
PUBLIC_ACCESS_TTL_SECONDS=900
USER_TOKEN_TTL_SECONDS=900
