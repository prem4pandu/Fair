model IdentityUser {
  id            String                     @id @default(uuid()) @db.Uuid
  email         String                     @unique @db.VarChar(254)
  phone         String?                    @unique @db.VarChar(20)
  displayName   String                     @db.VarChar(100)
  status        String                     @default("ACTIVE")
  emailVerified Boolean                    @default(false)
  roles         String[]
  createdAt     DateTime                   @default(now()) @db.Timestamptz(3)
  credential    IdentityCredential?
  grants        IdentityApplicationGrant[]
  families      IdentitySessionFamily[]
  addresses     CustomerAddress[]
}

model IdentityCredential {
  userId       String       @id @db.Uuid
  passwordHash String
  user         IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model IdentityApplicationGrant {
  userId      String       @db.Uuid
  application String
  active      Boolean      @default(true)
  user        IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, application])
}

model IdentitySessionFamily {
  id          String                   @id @default(uuid()) @db.Uuid
  userId      String                   @db.Uuid
  application String
  createdAt   DateTime                 @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime                 @db.Timestamptz(3)
  revokedAt   DateTime?                @db.Timestamptz(3)
  user        IdentityUser             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions    IdentityRefreshSession[]

  @@unique([id, userId])
  @@index([userId])
}

model IdentityRefreshSession {
  id         String                @id @db.Uuid
  familyId   String                @db.Uuid
  userId     String                @db.Uuid
  tokenHash  String                @unique @db.Char(64)
  createdAt  DateTime              @default(now()) @db.Timestamptz(3)
  consumedAt DateTime?             @db.Timestamptz(3)
  family     IdentitySessionFamily @relation(fields: [familyId, userId], references: [id, userId], onDelete: Restrict)

  @@index([familyId])
}

model IdentityAuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  familyId   String?  @db.Uuid
  action     String   @db.VarChar(40)
  outcome    String   @db.VarChar(10)
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
}

/// Server-generated, single-use verification challenges. Only hashes are
/// stored: neither the recipient nor the code can be recovered from the row.
model IdentityVerificationChallenge {
  id         String    @id @db.Uuid
  purpose    String    @db.VarChar(20)
  channel    String    @db.VarChar(10)
  targetHash String    @db.Char(64)
  codeHash   String    @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([targetHash, purpose, createdAt])
}
